{
  "name": "pi-deepinfra",
  "version": "0.1.0",
  "description": "DeepInfra model provider for the pi coding agent. Discovers the model catalog live from api.deepinfra.com/models/list, so there are no hard-wired model entries.",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    }
  },
  "license": "MIT",
  "author": "Chris Guidry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisguidry/pi-deepinfra.git"
  },
  "homepage": "https://github.com/chrisguidry/pi-deepinfra",
  "bugs": {
    "url": "https://github.com/chrisguidry/pi-deepinfra/issues"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package",
    "pi",
    "deepinfra",
    "llm",
    "coding-agent",
    "provider",
    "extension"
  ],
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  }
}
